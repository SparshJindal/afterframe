DATABASE_URL=postgresql://afterframe:CHANGE_ME@localhost:5432/afterframe
PORT=3000
# Required for production CSRF origin validation:
APP_ORIGIN=https://your-afterframe-domain.example
NODE_ENV=production
# For managed PostgreSQL with a valid trusted TLS certificate:
# PGSSL=true
# Authenticated version. Do not commit actual secrets.
# Generate AUTH_SECRET locally: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=REPLACE_WITH_RANDOM_BASE64_32_BYTE_SECRET
RESEND_API_KEY=REPLACE_WITH_YOUR_PROVIDER_API_KEY
MAIL_FROM=Afterframe <accounts@your-verified-domain.example>
# Production breach screening is mandatory and cannot be disabled.
HIBP_CHECK=true
# Set true only for a controlled migration/seed run with a migration DB role.
# Runtime production DB roles should not have DDL permissions.
RUN_MIGRATIONS=false

# Dev binds to loopback by default. Set HOST=0.0.0.0 only for deliberate container/proxy use.
# HOST=0.0.0.0

# Optional OpenAI filter extraction. Disabled by default; the user must also opt in per form.
LLM_ENABLED=false
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_DAILY_REQUEST_LIMIT=1000
